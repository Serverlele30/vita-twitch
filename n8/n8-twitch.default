# /etc/default/n8-twitch  - Einstellungen fuer n8-transcode.sh
N8_SRC_BASE=https://ttv.serverlele.de
# transcode = 360p Baseline (laeuft sicher auf dem N8, ~0,5 Kern pro Stream)
# copy      = Twitch-Video unveraendert (kaum Last, aber nur wenn das N8 das Profil abspielt)
N8_MODE=transcode
N8_HEIGHT=360
N8_VBITRATE=700k
