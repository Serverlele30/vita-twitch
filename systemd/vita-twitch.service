[Unit]
Description=PS Vita Twitch Kraken-to-Helix Adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/vita-twitch.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/vita-twitch/adapter.py
Restart=always
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/vita-twitch
StateDirectory=vita-twitch
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
