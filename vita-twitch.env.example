# /etc/vita-twitch.env  (chmod 600) - Zugangsdaten nie in den Code schreiben
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# eigener Hostname (muss auf der Vita in redirects.txt stehen)
VITA_PUBLIC_BASE=https://ytv.serverlele.de
# optional: auth-token-Cookie von twitch.tv -> Wiedergabe mit Turbo/Abo-Vorteilen (werbefrei)
#TWITCH_WEB_AUTH_TOKEN=
# optional: Turbo vorhanden -> App blendet ihre eigene Werbung nicht ein
#VITA_TURBO=1
# Das Web-Token gilt nur fuer sein eigenes Konto (wird beim Start erkannt). Andere Konten spielen
# anonym ab und bekommen Werbung nach Twitch-Regeln. Nur zum Teilen mit allen:
#VITA_WEB_TOKEN_SHARE=1
# optional: Link zum Quellcode auf der Infoseite
#VITA_REPO_URL=https://git.serverlele.de/Serverlele30/vita-twitch
# optional: Darstellung
#VITA_PROFILE_BG=#1f1f23
#VITA_BANNER_DIM=0.4
#VITA_MAX_HEIGHT=720
