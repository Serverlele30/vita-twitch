#!/bin/bash
# vita-cert-renew [--dry-run]
# Verlaengert das RSA-Zertifikat "ytv-rsa" im NPM-Container. NPM erneuert es nicht selbst,
# weil es ausserhalb der NPM-Oberflaeche angelegt wurde (die Vita braucht RSA statt ECDSA).
# certbot erneuert nur, wenn das Zertifikat in weniger als 30 Tagen ablaeuft; nginx wird nur dann neu geladen.
set -uo pipefail
NPM=${VITA_NPM_CONTAINER:-npm-npm-1}
CERT=${VITA_CERT_NAME:-ytv-rsa}
PEM=/root/npm/letsencrypt/live/$CERT/fullchain.pem
WARN_DAYS=14
DRY=""; [ "${1:-}" = "--dry-run" ] && DRY="--dry-run"

days_left() {
  local end; end=$(openssl x509 -enddate -noout -in "$PEM" 2>/dev/null | cut -d= -f2) || return 1
  echo $(( ( $(date -d "$end" +%s) - $(date +%s) ) / 86400 ))
}

[ -f "$PEM" ] || { echo "FEHLER: $PEM fehlt"; exit 1; }
docker inspect "$NPM" >/dev/null 2>&1 || { echo "FEHLER: Container $NPM laeuft nicht"; exit 1; }
before=$(days_left)
echo "Zertifikat $CERT: noch $before Tage gueltig${DRY:+ (Probelauf)}"

if ! docker exec "$NPM" certbot renew --config /etc/letsencrypt.ini --cert-name "$CERT" \
       --non-interactive --no-random-sleep-on-renew $DRY --deploy-hook "nginx -s reload"; then
  echo "FEHLER: certbot renew fehlgeschlagen (Log: docker exec $NPM tail -50 /tmp/letsencrypt-log/letsencrypt.log)"
  exit 1
fi

after=$(days_left)
[ "$after" -gt "$before" ] && echo "Erneuert: jetzt $after Tage gueltig, nginx neu geladen" || echo "Keine Erneuerung noetig ($after Tage)"
if [ "$after" -lt "$WARN_DAYS" ]; then
  echo "WARNUNG: Zertifikat laeuft in $after Tagen ab!"
  exit 2
fi
